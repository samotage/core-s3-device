// WiFi credentials for the meeting recorder's HTTP server.
//
// Copy this file to `include/secrets.h` and fill in your network.
// `secrets.h` is gitignored and must NEVER be committed (this repo is public).
//
// If secrets.h is absent the firmware still builds — it just runs the recorder
// offline (no WiFi, no HTTP server).

#ifndef __SECRETS_H
#define __SECRETS_H

#define WIFI_SSID    "your-wifi-ssid"
#define WIFI_PASS    "your-wifi-password"

// mDNS hostname — the device is reachable at http://<REC_HOSTNAME>.local
#define REC_HOSTNAME "core-s3"

// Headspace upload endpoint (plain HTTP, LAN — the ESP32 can't do TLS/Tailscale).
// The device pushes recorded WAV files here when idle. Discovery is normally via
// mDNS service browse (_otl-recordings._tcp), so this is only a compile-time
// FALLBACK for bench testing when mDNS can't resolve. If mDNS resolves it takes
// priority. Leave undefined to rely on mDNS alone (or to disable uploads when
// neither resolves — recorder still works offline).
#define HEADSPACE_UPLOAD_URL "http://192.168.4.11:15055/api/uploads/recordings"

#endif  // __SECRETS_H
